          <site name="pegTop" pos="0 0 0.05" size="0.005" rgba="0 0.8 0 1"/>
        </body>

        <!-- Distraction objects for clutter experiments -->
        <body name="clutter_0" pos="-0.1 0.65 0.02" childclass="block_base">
